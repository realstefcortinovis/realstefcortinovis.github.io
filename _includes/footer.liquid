{% capture social_icons %}
  {% if page.social %}
    <div class="social-sticky-bottom">
      <div class="contact-icons">{% include social.liquid %}</div>
      <div class="contact-note">{{ site.contact_note }}</div>
    </div>
  {% endif %}
{% endcapture %}

{% capture footer_text_only %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<div class="fixed-bottom-socials">
  <div class="container">
    {{ social_icons }}
  </div>
</div>

<footer class="mt-5" role="contentinfo">
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}
  <div class="container">
    {{ footer_text_only }}
  </div>
</footer>
